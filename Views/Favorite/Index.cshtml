@model List<AliersEcom.Models.Favorite>
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Aliers — Favorilerim</title>
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/style.css">
    </head>
    <body>

        <nav class="navbar">
            <div class="nav-inner">
                <a href="/" class="logo">
                    <span class="logo-text">Aliers</span>
                    <span class="logo-dot"></span>
                </a>
                <div class="nav-links">
                    <a href="/" class="nav-link">Ana Sayfa</a>
                    <a href="/Favorite/Index" class="nav-link active">Favorilerim</a>
                </div>
                <div class="nav-actions">
                    <a href="/Account/Logout" class="btn btn-ghost">Çıkış</a>
                </div>
            </div>
        </nav>

        <section style="padding:120px 24px 80px">
            <div class="container">
                <div class="section-header">
                    <h2 class="section-title">Favorilerim</h2>
                    <span class="section-count">@Model.Count ürün</span>
                </div>

                @if (Model.Count == 0)
                {
                    <div style="text-align:center;padding:80px 0;color:var(--text-muted)">
                        <div style="font-size:48px;margin-bottom:16px">💔</div>
                        <p style="font-size:18px;margin-bottom:8px">Henüz favori ürününüz yok.</p>
                        <a href="/" class="btn btn-primary" style="margin-top:16px">Ürünleri Keşfet</a>
                    </div>
                }
                else
                {
                    <div class="products-grid">
                        @foreach (var fav in Model)
                        {
                            <article class="product-card">
                                <div class="card-img-wrap">
                                    @if (!string.IsNullOrEmpty(fav.Product.ImageUrl))
                                    {
                                        <img src="@fav.Product.ImageUrl" alt="@fav.Product.Name" style="width:100%;height:100%;object-fit:cover;">
                                    }
                                    else
                                    {
                                        <div class="placeholder-img" style="background:linear-gradient(135deg,#1a1a2e,#16213e);width:100%;height:100%;display:flex;align-items:center;justify-content:center;">
                                            <div class="placeholder-icon">📦</div>
                                        </div>
                                    }
                                    <span class="card-badge new">@fav.Product.Category</span>
                                    <a href="/Favorite/Remove/@fav.Id" class="card-save" title="Favoriden kaldır" style="color:#f87171">
                                        <svg viewBox="0 0 24 24" fill="#f87171" stroke="#f87171" stroke-width="2">
                                            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
                                        </svg>
                                    </a>
                                </div>
                                <div class="card-body">
                                    <div class="card-tags">
                                        @foreach (var tag in fav.Product.Tags.Split(','))
                                        {
                                            <span class="tag">@tag.Trim()</span>
                                        }
                                    </div>
                                    <h3 class="card-title">@fav.Product.Name</h3>
                                    <p class="card-desc">@fav.Product.Description</p>
                                    <div class="card-footer">
                                        <div class="card-price">
                                            <span class="price-label">Tedarikçi Fiyatı</span>
                                            <span class="price">$@fav.Product.SupplierPrice</span>
                                        </div>
                                        <a href="/Product/Detail/@fav.Product.Id" class="btn btn-sm btn-primary">İncele</a>
                                    </div>
                                </div>
                            </article>
                        }
                    </div>
                }
            </div>
        </section>

    </body>
</html>
